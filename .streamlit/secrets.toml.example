# Copy this file to .streamlit/secrets.toml (local, git-ignored)
# or paste its content in Streamlit Cloud > App settings > Secrets.
#
# Without LLM_API_KEY, pages 11-12 use your local Ollama (model "mistral").

# --- Groq (free tier, very fast) : https://console.groq.com/keys
LLM_API_KEY = "gsk_..."
LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL = "llama-3.1-8b-instant"

# --- Alternative: Mistral AI (free tier) : https://console.mistral.ai/api-keys
# LLM_API_KEY = "..."
# LLM_BASE_URL = "https://api.mistral.ai/v1"
# LLM_MODEL = "mistral-small-latest"
